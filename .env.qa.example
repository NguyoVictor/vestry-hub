# COPY TO .env.qa.local (git-ignored); only when a REAL disposable QA backend exists.
# Do NOT fill these fields with the Vestry staging or churchapp project.
# For local Docker Supabase: VITE_SUPABASE_URL=http://127.0.0.1:54321, ID=local.
VITE_SUPABASE_URL=https://REPLACE_DISPOSABLE_QA_REF.supabase.co
VITE_SUPABASE_PROJECT_ID=REPLACE_DISPOSABLE_QA_REF
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_QA_PUBLISHABLE_KEY
# Only if the current client reads the legacy variable:
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_QA_ANON_KEY
