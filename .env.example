# Browser-safe Supabase configuration
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase CLI/server-only configuration
# Never prefix server credentials with VITE_ and never commit real values.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_DB_PASSWORD=your-database-password

# Sentry browser configuration
VITE_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
VITE_SENTRY_ORG=your-org-slug
VITE_SENTRY_PROJECT=your-project-slug
# Server/CI only. Do not expose through VITE_.
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# PostHog browser configuration
VITE_POSTHOG_KEY=phc_xxxx
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_POSTHOG_DASHBOARD_URL=https://app.posthog.com/shared_dashboard/xxxx

# Firebase web configuration (browser-safe identifiers/keys)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-vapid-key

# Public application configuration
VITE_BASE_URL=https://app.vestryhub.com
VITE_TENANT_BASE_DOMAIN=vestryhub.com
VITE_GA_MEASUREMENT_ID=your-ga4-measurement-id

# AI provider keys belong in Supabase Edge Function secrets only.
# GROQ_API_KEY=server-side-only
