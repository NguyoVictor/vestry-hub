# Supabase
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-access-token
SUPABASE_DB_PASSWORD=your-db-password

# Sentry — Error & Performance Monitoring
# Get DSN from: Sentry → Project → Settings → Client Keys
VITE_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
# Get auth token from: Sentry → Settings → Auth Tokens
VITE_SENTRY_AUTH_TOKEN=sntrys_xxxx
# Your Sentry organisation slug (visible in the URL: sentry.io/organizations/{slug})
VITE_SENTRY_ORG=your-org-slug
# Your Sentry project slug
VITE_SENTRY_PROJECT=your-project-slug

# PostHog — Product Analytics
# Get project API key from: PostHog → Project Settings → Project API Key
VITE_POSTHOG_KEY=phc_xxxx
# PostHog host — use https://app.posthog.com for cloud, or your self-hosted URL
VITE_POSTHOG_HOST=https://app.posthog.com
# Shareable dashboard URL from: PostHog → Dashboards → Share → Copy link
VITE_POSTHOG_DASHBOARD_URL=https://app.posthog.com/shared_dashboard/xxxx

# Firebase — Push Notifications
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-vapid-key

# Google Analytics GA4
VITE_GA_MEASUREMENT_ID=G-K4DP5L1678
